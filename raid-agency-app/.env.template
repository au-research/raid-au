PORT=7080

BASE_URL=http://localhost:7080

# E2E test credentials (not runtime config — used by Playwright only)
VITE_KEYCLOAK_E2E_USER=raid-test-user
VITE_KEYCLOAK_E2E_PASSWORD=

# Additional e2e credentials for role-specific test suites (RAID-659/480/608)
# - see iam/doc/keycloak-configuration.md for what each fixture user has access to
VITE_KEYCLOAK_E2E_OPERATOR_USER=raid-operator
VITE_KEYCLOAK_E2E_OPERATOR_PASSWORD=
VITE_KEYCLOAK_E2E_UNAPPROVED_ADMIN_USER=raid-au-unapproved-admin
VITE_KEYCLOAK_E2E_UNAPPROVED_ADMIN_PASSWORD=

# All service URLs, Keycloak config and environment settings are configured in
# public/app-config.json — edit that file for local dev or mount it
# per-deployment in production.
#
# Branding (theme, header, footer) is not set here and does not belong in
# public/. It lives in the external app-config.json (S3, a volume mount or
# APP_CONFIG_URL) and applies only when the realm's Keycloak login theme is not
# raid-custom. Copy the sections you need from
# app-config-examples/app-config.ardc.example.json. See
# doc/UI/raid-agency-app/DEPLOYMENT.md.
