---
// ArdcFooter.astro
// Renders the real, centrally-managed ARDC footer (per ARDC Web
// Components Developer Documentation) - the same <ardc-footer>
// integration used in raid-agency-app.
// Only shown when footer.show=true in app-config.json
import { getSiteConfig } from "@/config";

const { show, links } = getSiteConfig().footer;
const quickLinks = links.filter((link) => link.path.startsWith("mailto:"));
const legalLinks = links.filter((link) => !link.path.startsWith("mailto:"));
---

{show && (
  <>
    <ardc-footer
      class="ardc-footer ardc-custom-component"
      data-content-width="normal"
      data-show-ardc-logo
      style="opacity: 0;"
    >
      <ul id="quick-links">
        {quickLinks.map((link) => (
          <li><a href={link.path}>{link.label}</a></li>
        ))}
      </ul>
      <ul id="legal-links">
        {legalLinks.map((link) => (
          <li><a href={link.path}>{link.label}</a></li>
        ))}
      </ul>
      <a id="ardc-footer-acn" href="https://www.acnc.gov.au/charity/charities/eca273f3-f5be-e911-a98a-000d3ad02a61/profile">ACN 633 798 857</a>
    </ardc-footer>
    <script
      is:inline
      src="https://ardc.edu.au/wp-content/plugins/ardc-custom-web-components/dist/loaders/footer.min.js"
      defer
      data-no-optimize
      onerror="document.querySelector('.ardc-footer').style.display='none'"
    ></script>
  </>
)}
